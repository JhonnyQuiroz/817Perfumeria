{
 "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
 "version": 1,
 "newProjectRoot": "projects",
 "projects": {
  "landing-angular": {
   "projectType": "application",
   "root": "",
   "sourceRoot": "src",
   "prefix": "app",
   "architect": {
    "build": {
     "builder": "@angular/build:application",
     "options": {
      "outputPath": "dist/landing-angular",
      "index": "src/index.html",
      "browser": "src/main.ts",
      "polyfills": [
       "zone.js"
      ],
      "tsConfig": "tsconfig.app.json",
      "assets": [
       "src/favicon.svg",
       {
        "glob": "**/*",
        "input": "public"
       }
      ],
      "styles": [
       "src/styles.css"
      ],
      "scripts": []
     },
     "configurations": {
      "production": {
       "outputHashing": "all"
      },
      "development": {
       "optimization": false,
       "sourceMap": true
      }
     },
     "defaultConfiguration": "production"
    }
   }
  }
 }
}